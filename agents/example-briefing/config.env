# Per-agent overrides for example-briefing.
TIMEOUT_SECONDS=300
MODEL=haiku

# This agent needs to write one file, so it opts into Write explicitly.
ALLOWED_TOOLS="Bash,Read,Glob,Grep,Write"
DISALLOWED_TOOLS="Edit,NotebookEdit"

# Delivery verification: the briefing file must exist AND have been modified at or
# after this run started. RUN_START_EPOCH is exported by runner.sh for exactly this.
# A stale file from yesterday does not count.
VERIFY_CMD='f="$HOME/briefings/latest.md"; [ -f "$f" ] && [ "$(stat -c %Y "$f")" -ge "$RUN_START_EPOCH" ]'

# If verification fails, run once more with a blunter contract appended.
RETRY_ON_VERIFY_FAIL=1
RETRY_PROMPT_SUFFIX='

REMINDER: this is an unattended cron run. Do NOT ask anything. Execute every step above and write the file NOW.'
